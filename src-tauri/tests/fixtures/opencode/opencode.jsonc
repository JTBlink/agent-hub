{
  "$schema": "https://opencode.ai/config.json",
  // JSONC comments and trailing commas are supported by OpenCode.
  "model": "openai/gpt-5.3-codex",
  "token": "fixture-secret",
  "instructions": ["AGENTS.md", "docs/rules/*.md"],
  "permission": {
    "bash": "ask",
    "edit": "allow",
  },
  "futureOption": {
    "enabled": true,
  },
}
