{
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "agenthub-managed-updates",
          "description": "The bundled manager is updated with AgentHub.",
          "windows": ["main"],
          "permissions": [
            "updater:deny-download",
            "updater:deny-install",
            "updater:deny-download-and-install"
          ]
        }
      ]
    }
  }
}
