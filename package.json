{
  "name": "agent-hub",
  "private": true,
  "version": "0.1.9",
  "license": "MIT",
  "homepage": "https://jtblink.github.io/agent-hub/",
  "type": "module",
  "scripts": {
    "dev": "lsof -nP -tiTCP:1420 -sTCP:LISTEN | xargs kill 2>/dev/null; sleep 0.5; lsof -nP -tiTCP:1420 -sTCP:LISTEN | xargs kill -9 2>/dev/null; vite",
    "build": "tsc -b && vite build",
    "app:dev": "node scripts/build.mjs dev",
    "app:build": "node scripts/build.mjs build",
    "app:clean": "node scripts/build.mjs clean",
    "app:release": "node scripts/build.mjs release",
    "app:test": "node scripts/build.mjs test",
    "app:lint": "node scripts/build.mjs lint",
    "app:version": "node scripts/build.mjs version",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:verify": "node scripts/verify-release-bundle.mjs",
    "release:ready": "node scripts/check-release-candidate.mjs",
    "homepage:build": "node scripts/build-homepage.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:sync": "node scripts/set-version.mjs",
    "tasks:check": "node scripts/check-task-status.mjs",
    "tauri": "node scripts/primary-app.mjs",
    "cli": "node scripts/run-rust-cli.mjs cli",
    "cli:build": "node scripts/run-rust-cli.mjs build",
    "cli:install": "node scripts/run-rust-cli.mjs install",
    "predev": "npm run docs:generate",
    "prebuild": "npm run docs:generate",
    "pretest": "npm run docs:generate",
    "docs:generate": "node scripts/docs/build-help.mjs",
    "docs:check": "node scripts/docs/build-help.mjs --check",
    "docs:build": "npm run docs:generate && vitepress build docs-site",
    "docs:dev": "npm run docs:generate && vitepress dev docs-site --host 127.0.0.1 --port 4174",
    "website:build": "npm run homepage:build -- _site/index.html && npm run docs:build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "clsx": "^2.1.1",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "minisearch": "7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "github-slugger": "2.0.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "remark-parse": "11.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vite": "^7.3.1",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4"
  }
}
